# Agent Observability Platform — copy to .env and edit

# Application
APP_NAME=Agent Observability Platform
VERSION=1.0.0
DEBUG=false
PORT=8000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_observability
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# Redis Streams
REDIS_STREAM_NAME=trace_events
REDIS_CONSUMER_GROUP=processors
REDIS_CONSUMER_NAME=processor_1

# Authentication (RS256 — run python generate_keys.py)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=RS256
JWT_EXPIRATION_MINUTES=60
API_KEY_HASH_ROUNDS=12

# Storage (S3 or MinIO)
S3_BUCKET=agent-observability-archives
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Retention
HOT_STORAGE_DAYS=30
WARM_STORAGE_DAYS=90
ARCHIVE_ENABLED=true

# Processing
BATCH_SIZE=100
PROCESSING_WORKERS=4

# WebSocket (future)
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000
